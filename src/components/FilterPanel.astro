---
import type { Category, Publisher } from '../types/game';

interface Props {
  categories: Category[];
  publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<div class="bg-slate-700 rounded-lg p-6 mb-8" data-testid="filter-panel">
  <h2 class="text-xl font-medium text-slate-100 mb-4">Filter Games</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <h3 class="text-lg font-medium text-slate-200 mb-3">Categories</h3>
      <div class="space-y-2" data-testid="category-filters">
        {categories && categories.length > 0 ? (
          categories.map((category) => (
            <label class="flex items-center cursor-pointer group">
              <input
                type="checkbox"
                value={category.id}
                data-testid={`category-checkbox-${category.id}`}
                class="w-4 h-4 rounded bg-slate-600 border border-slate-500 text-blue-500 focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-700 focus:ring-blue-500 focus:outline-none cursor-pointer"
              />
              <span class="ml-2 text-slate-200 group-hover:text-slate-100">
                {category.name}
              </span>
            </label>
          ))
        ) : (
          <p class="text-slate-400">No categories available</p>
        )}
      </div>
    </div>

    <div>
      <h3 class="text-lg font-medium text-slate-200 mb-3">Publishers</h3>
      <div class="space-y-2" data-testid="publisher-filters">
        {publishers && publishers.length > 0 ? (
          publishers.map((publisher) => (
            <label class="flex items-center cursor-pointer group">
              <input
                type="checkbox"
                value={publisher.id}
                data-testid={`publisher-checkbox-${publisher.id}`}
                class="w-4 h-4 rounded bg-slate-600 border border-slate-500 text-blue-500 focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-700 focus:ring-blue-500 focus:outline-none cursor-pointer"
              />
              <span class="ml-2 text-slate-200 group-hover:text-slate-100">
                {publisher.name}
              </span>
            </label>
          ))
        ) : (
          <p class="text-slate-400">No publishers available</p>
        )}
      </div>
    </div>
  </div>

  <button
    type="button"
    class="mt-6 px-4 py-2 bg-slate-600 text-slate-100 rounded font-medium hover:bg-slate-500 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors"
    data-testid="clear-filters-button"
    aria-label="Clear all filters"
  >
    Clear All Filters
  </button>
</div>
